# ==============================================================================
# AI Coding Assessment Platform - Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Server Port
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Gemini API Key (Required for future AI hint and code review agents)
GEMINI_API_KEY="your-gemini-api-key-here"

# MongoDB Connection URI (Required for future persistent database storage)
# Example: mongodb+srv://username:password@cluster.mongodb.net/assessment_platform?retryWrites=true&w=majority
MONGODB_URI="your-mongodb-connection-string-here"

# Application Public Host URL (Used for Cloud Run or OAuth callbacks)
APP_URL="http://localhost:3000"
