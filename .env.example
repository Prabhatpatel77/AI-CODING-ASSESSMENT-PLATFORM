# ==============================================================================
# AI Coding Assessment Platform - Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Server Port
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Authentication (JWT) Configuration
# ------------------------------------------------------------------------------
# Secret key used for signing JSON Web Tokens (use a strong random 32+ character string in production)
JWT_SECRET="devassess_secure_random_jwt_secret_key_min_32_characters_here"

# Token expiration period (e.g., '1d', '7d', '24h')
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# MongoDB Connection URI (Mongoose)
# ------------------------------------------------------------------------------
# Choose one of the following formats depending on your environment:
#
# 1. Local MongoDB (Native service):
#    MONGODB_URI="mongodb://localhost:27017/assessment_platform"
#
# 2. Local MongoDB (via Docker container):
#    Command to start container:
#      docker run -d -p 27017:27017 --name devassess-mongo mongo:latest
#    MONGODB_URI="mongodb://127.0.0.1:27017/assessment_platform"
#
# 3. MongoDB Atlas (Cloud Cluster):
#    MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/assessment_platform?retryWrites=true&w=majority"
#
MONGODB_URI="mongodb://127.0.0.1:27017/assessment_platform"

# ------------------------------------------------------------------------------
# Isolated Code Execution Service (Remote Judge Sandbox)
# ------------------------------------------------------------------------------
# Security Policy: Student code is never executed inside the main web server process.
# An external isolated sandbox provider must be configured.
#
# Provider selection: 'judge0' | 'piston' | 'unconfigured'
EXECUTION_PROVIDER="unconfigured"

# Option 1: Judge0 CE / RapidAPI (Recommended)
# Self-hosted Docker container:
#   docker run -d -p 2358:2358 judge0/judge0:latest
# JUDGE0_API_URL="http://localhost:2358"
# JUDGE0_API_KEY=""
#
# Or RapidAPI Judge0 Cloud:
# JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
# JUDGE0_API_KEY="your-rapidapi-key"

# Option 2: EngineerMan Piston API
# PISTON_API_URL="http://localhost:2000/api/v2"

# Execution Resource Bounds
EXECUTION_CPU_TIME_LIMIT="2.0"
EXECUTION_MEMORY_LIMIT_MB="128"

# ------------------------------------------------------------------------------
# Additional Platform Services (Configured in subsequent phases)
# ------------------------------------------------------------------------------
# Gemini API Key (Required for AI coaching, hints, and code review)
GEMINI_API_KEY="your-gemini-api-key-here"

# Application Public Host URL (Used for Cloud Run, self-referential links)
APP_URL="http://localhost:3000"
