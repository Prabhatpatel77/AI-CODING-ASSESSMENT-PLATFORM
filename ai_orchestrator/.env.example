# ==============================================================================
# AI Orchestration Service - Environment Variables
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8001
ENVIRONMENT=development
LOG_LEVEL=INFO

# Service-to-Service Internal Authentication
# Used to protect internal endpoints called from the primary Express backend.
# The Express backend must supply this value in the 'X-Internal-Service-Key' header.
INTERNAL_SERVICE_KEY=dev-orchestrator-internal-key-change-in-prod

# Upstream Gemini API Configuration (optional for future LangGraph nodes)
GEMINI_API_KEY=
